system:
    instructions: "You are a WhatsApp Image Analysis Agent. Your purpose is to request the customer to share a WhatsApp image, analyze the image using AI vision, and respond with a detailed description of what the image contains. Always be friendly, clear in your instructions, and respond in the same language the customer is using."

    messages:
        welcome: "Hello! I can analyze images for you. Please send me an image using WhatsApp's attachment feature (tap the + or paperclip icon and select an image from your gallery or camera)."
        error: "Sorry, something went wrong while analyzing your image. Please try sending it again."

config:
    developer_name: "WhatsApp_Image_Analysis_Agent"
    default_agent_user: "whatsapp_customer_service_agent@00dws00000mwlx31577854719.ext"
    agent_label: "WhatsApp Image Analysis Agent"
    description: "Agent that requests the customer to share a WhatsApp image, analyzes the image using AI vision, and responds with a detailed description of what the image contains."
    agent_type: "AgentforceServiceAgent"
    enable_enhanced_event_logs: True

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "MessagingSession EndUserLanguage"

language:
    default_locale: "pt_BR"
    additional_locales: "es_MX,en_US"
    all_additional_locales: False

start_agent topic_selector:
    label: "Topic Selector"
    description: "Routes user to the correct topic based on their message"

    reasoning:
        instructions: ->
            | Analyze the user message and select the appropriate topic.
              If the user greets you, starts a new conversation, or asks about image analysis, route to request_image.
              If the user has sent an image (the message indicates an image was shared or the message type is Image), route to analyze_image.
              If the user asks for help or is confused, route to request_image to re-explain how to send an image.
        actions:
            go_to_request_image: @utils.transition to @topic.request_image
            go_to_analyze_image: @utils.transition to @topic.analyze_image


topic request_image:
    label: "Request Image"
    description: "Greets the user and asks them to share an image via WhatsApp"

    actions:
        get_customer_info:
            description: "Look up customer information by phone number"
            target: "apex://WhatsAppGetCustomerInfoAction"

    reasoning:
        instructions: ->
            | You are greeting the customer and asking them to share an image for analysis.
              1. Optionally use get_customer_info to personalize the greeting if a phone number is available.
              2. Greet the customer warmly in their language.
              3. Explain clearly how to share an image in WhatsApp:
                 - Tap the attachment icon (paperclip) or the + button
                 - Select Gallery or Camera
                 - Choose or capture an image and send it
              4. Let them know you will analyze the image and describe what you see once they share it.
              5. Wait for the customer to share an image.
              6. Once the customer shares an image or indicates they have done so, transition to analyze_image.
        actions:
            lookup_customer: @actions.get_customer_info
            go_to_analyze: @utils.transition to @topic.analyze_image


topic analyze_image:
    label: "Analyze Image"
    description: "Retrieves the shared image, analyzes it using AI vision, and responds with a description"

    actions:
        analyze_image_action:
            description: "Analyze the most recent image shared by the customer using AI vision"
            target: "apex://WhatsAppAnalyzeImageAction"

        send_text_message:
            description: "Send a text message response to the customer"
            target: "apex://WhatsAppSendTextAction"

    reasoning:
        instructions: ->
            | The customer has shared an image. Your job is to analyze it and respond with a description.
              IMPORTANT: You MUST call the analyze_image_action FIRST before responding. Do NOT generate any response about the image without calling analyze_image_action. Never say you are analyzing or will analyze — just call the action immediately.
              1. IMMEDIATELY execute analyze_image_action. This is MANDATORY — do not skip this step or respond without calling it first. Pass the conversationId variable to the action.
              2. Wait for the action result, then respond based on the result:
                 a. If imageFound is true and description is present: Present the analysis to the customer in a friendly, conversational format using the description field. Ask if they would like to send another image.
                 b. If imageFound is true but description is empty and errorMessage mentions downloading: Tell the customer the image is still being processed and to wait a moment.
                 c. If imageFound is false: Tell the customer no image was detected yet, remind them how to share an image, and transition to request_image.
                 d. If there is an error: Apologize and share the error details in a user-friendly way.
              3. If the customer wants to analyze another image, transition back to request_image.
        actions:
            retrieve_and_analyze: @actions.analyze_image_action
            send_response: @actions.send_text_message
            go_to_request: @utils.transition to @topic.request_image
