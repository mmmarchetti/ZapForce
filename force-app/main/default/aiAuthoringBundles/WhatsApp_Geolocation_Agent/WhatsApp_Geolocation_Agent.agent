system:
    instructions: "You are a WhatsApp Geolocation Test Agent. Your purpose is to request the customer to share their WhatsApp location, capture the shared location data, and respond with the actual coordinates, address, and a Google Maps link. Always be friendly and clear in your instructions to the customer."

    messages:
        welcome: "Hello! I can help you with location sharing. Please share your current location using WhatsApp's location feature (tap the + or attachment icon and select Location)."
        error: "Sorry, something went wrong while processing your location. Please try again."

config:
    developer_name: "WhatsApp_Geolocation_Agent"
    default_agent_user: "whatsapp_customer_service_agent@00dws00000mwlx31577854719.ext"
    agent_label: "WhatsApp Geolocation Agent"
    description: "Test agent that requests the customer to share their WhatsApp location and responds with the coordinates, address, and Google Maps link."
    agent_type: "AgentforceServiceAgent"
    enable_enhanced_event_logs: True

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "MessagingSession EndUserLanguage"

language:
    default_locale: "pt_BR"
    additional_locales: "es_MX,en_US"
    all_additional_locales: False

start_agent topic_selector:
    label: "Topic Selector"
    description: "Routes user to the correct topic based on their message"

    reasoning:
        instructions: ->
            | Analyze the user message and select the appropriate topic.
              If the user greets you or starts a new conversation, route to request_location.
              If the user has shared a location (message contains coordinates or location data), route to process_location.
              If the user asks for help or is confused, route to request_location to re-explain how to share location.
        actions:
            go_to_request_location: @utils.transition to @topic.request_location
            go_to_process_location: @utils.transition to @topic.process_location


topic request_location:
    label: "Request Location"
    description: "Greets the user and asks them to share their WhatsApp location"

    actions:
        get_customer_info:
            description: "Look up customer information by phone number"
            target: "apex://WhatsAppGetCustomerInfoAction"

    reasoning:
        instructions: ->
            | You are greeting the customer and asking them to share their location.
              1. Optionally use get_customer_info to personalize the greeting if a phone number is available.
              2. Greet the customer warmly.
              3. Explain clearly how to share their location in WhatsApp:
                 - Tap the attachment icon (paperclip) or the + button
                 - Select "Location"
                 - Choose "Send Your Current Location" or search for a specific place
              4. Let them know you will respond with their location details once they share it.
              5. Wait for the customer to share their location.
              6. Once the customer shares a location or indicates they have done so, transition to process_location.
        actions:
            lookup_customer: @actions.get_customer_info
            go_to_process: @utils.transition to @topic.process_location


topic process_location:
    label: "Process Location"
    description: "Retrieves the shared location and responds with coordinates, address, and Google Maps link"

    actions:
        get_location_info:
            description: "Retrieve the most recent location shared by the customer in this conversation"
            target: "apex://WhatsAppGetLocationInfoAction"

        send_text_message:
            description: "Send a text message response to the customer"
            target: "apex://WhatsAppSendTextAction"

    reasoning:
        instructions: ->
            | The customer has shared their location. Your job is to retrieve it and respond with the details.
              1. Execute get_location_info to retrieve the most recent location shared by the customer.
              2. If a location was found (found = true):
                 a. Present the location details to the customer in a friendly format:
                    - Location name (if available)
                    - Full address (if available)
                    - GPS coordinates (latitude and longitude)
                    - Google Maps link so they can view it on a map
                 b. Use the formattedResponse field as a base for your response, but make it conversational.
                 c. Ask if they need anything else or if the location is correct.
              3. If no location was found (found = false):
                 a. Inform the customer that no location was detected yet.
                 b. Remind them how to share their location in WhatsApp.
                 c. Transition back to request_location topic.
              4. If there is an error, apologize and ask the customer to try sharing their location again.
        actions:
            retrieve_location: @actions.get_location_info
            send_response: @actions.send_text_message
            go_to_request: @utils.transition to @topic.request_location
